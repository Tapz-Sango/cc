@model CrustyCrab.Models.ApiMenuItem

@{
    ViewData["Title"] = "Edit Menu Item";
}

<div class="page-head">
    <div class="page-head-inner">
        <div>
            <span class="eyebrow">Menu Administration</span>
            <h1>Edit Menu Item</h1>
            <p class="muted">
                Update the details for this menu item.
            </p>
        </div>
    </div>
</div>

<div class="portal-wrap">
    <div class="portal-card">

        <form asp-controller="Menu"
              asp-action="UpdateForm"
              method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.MenuItemID" />

            <div class="field-row">
                <div class="field">
                    <label>Item Name</label>
                    <input name="ItemName"
                           value="@Model.ItemName"
                           required />
                </div>

                <div class="field">
                    <label>Category</label>
                    <input name="Category"
                           value="@Model.Category"
                           required />
                </div>
            </div>

            <div class="field-row">
                <div class="field">
                    <label>Price</label>
                    <input name="Price"
                           type="number"
                           step="0.01"
                           min="0"
                           value="@Model.Price"
                           required />
                </div>

                <div class="field">
                    <label>Image URL</label>
                    <input name="ImageUrl"
                           value="@Model.ImageUrl"
                           placeholder="/Images/example.jpg" />
                </div>
            </div>

            <div class="field">
                <label>Description</label>
                <textarea name="Description">@Model.Description</textarea>
            </div>

            <label class="addon" style="margin-bottom:18px;">
                <span>
                    <strong>Available</strong>
                    <small>
                        Show this item as in stock on the customer menu.
                    </small>
                </span>

                <input type="checkbox"
                       name="Availability"
                       value="true"
                @(Model.Availability ? "checked" : "") />

                <input type="hidden"
                       name="Availability"
                       value="false" />
            </label>

            <label class="addon" style="margin-bottom:18px;">
                <span>
                    <strong>Popular Dish</strong>
                    <small>
                        Feature this item in the Popular Dishes section on the homepage.
                    </small>
                </span>

                <input type="checkbox"
                       name="IsPopular"
                       value="true"
                @(Model.IsPopular ? "checked" : "") />

                <input type="hidden"
                       name="IsPopular"
                       value="false" />
            </label>

            <button class="btn-blue" type="submit">
                Save Changes
            </button>

        </form>

    </div>

</div>