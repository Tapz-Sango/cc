
@model List<CrustyCrab.Models.ApiCustomerReview>

@{
    ViewData["Title"] = "Customer Reviews";
}

<div class="portal-wrap">
    <div class="kds-head">
        <div>
            <span class="eyebrow">Admin Portal</span>
            <h1>Customer Reviews</h1>
            <p class="muted">Read customer feedback and respond to reviews.</p>
        </div>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="api-error" style="margin-top:20px">@error</div>
    }

    @if (TempData["Success"] is string success)
    {
        <div class="success-note" style="margin-top:20px">@success</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="portal-card" style="margin-top:24px">
            <p class="muted">There are no customer reviews yet.</p>
        </div>
    }
    else
    {
        <div style="display:grid; gap:20px; margin-top:24px">
            @foreach (var review in Model.OrderByDescending(r => r.CreatedAt))
            {
                <div class="portal-card">
                    <div class="kds-head">
                        <div>
                            <h3>@review.CustomerName</h3>
                            <small class="muted">
                                Review #@review.ReviewID ·
                                @review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </small>
                        </div>

                        <div class="review-stars" aria-label="@review.Rating out of 5 stars">
    @for (int i = 1; i <= 5; i++)
    {
        <span class="@(i <= review.Rating ? "filled" : "empty")">★</span>
    }
</div>
                    </div>

                    <div style="margin-top:16px">
                        <strong>Customer feedback</strong>
                        <p style="white-space:pre-wrap">@review.Comment</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(review.AdminResponse))
                    {
                        <div class="success-note" style="margin-top:16px">
                            <strong>Admin response</strong>
                            <p style="white-space:pre-wrap">@review.AdminResponse</p>

                            @if (review.RespondedAt.HasValue)
                            {
                                <small>
                                    Responded on
                                    @review.RespondedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </small>
                            }
                        </div>
                    }

                    <form action="@Url.Action("Respond", "Review")" method="post" style="margin-top:20px">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="reviewId" value="@review.ReviewID" />

                        <div class="field">
                            <label for="response-@review.ReviewID">
                                @(string.IsNullOrWhiteSpace(review.AdminResponse)
                                    ? "Write a response"
                                    : "Update your response")
                            </label>

                            <textarea id="response-@review.ReviewID"
                                      name="adminResponse"
                                      rows="3"
                                      maxlength="2000"
                                      required
                                      placeholder="Write a helpful response to the customer...">@review.AdminResponse</textarea>
                        </div>

                        <button type="submit" class="btn-blue">
                            @(string.IsNullOrWhiteSpace(review.AdminResponse)
                                ? "Submit Response"
                                : "Update Response")
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</div>
