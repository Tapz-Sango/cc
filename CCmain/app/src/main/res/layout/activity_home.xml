<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavWrapper">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivDashLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/app_logo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvDashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THE CRUSTY CRAB"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@+id/ivDashLogo"
                app:layout_constraintStart_toEndOf="@+id/ivDashLogo"
                android:layout_marginStart="12dp"/>

            <TextView
                android:id="@+id/tvDashLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MONTGOMERY PARK • RANDBURG"
                android:textColor="#3B5EFE"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toBottomOf="@+id/tvDashTitle"
                app:layout_constraintStart_toStartOf="@+id/tvDashTitle" />

            <TextView
                android:id="@+id/tvWelcomeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Welcome, James Bond!"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/ivDashLogo"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="32dp"/>

            <TextView
                android:id="@+id/tvWelcomeSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready for some fresh Cajun seafood today?"
                android:textColor="#8A8F9E"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/tvWelcomeName"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="4dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardActiveOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary"
                android:padding="20dp"
                app:layout_constraintTop_toBottomOf="@+id/tvWelcomeSub"
                android:layout_marginTop="24dp">

                <TextView
                    android:id="@+id/tvOrderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="No Active Orders"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvOrderSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Place an order to track it live"
                    android:textColor="#A0B3FF"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@+id/tvOrderTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:backgroundTint="#5A7AFF"
                    android:text="Ready"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvQuickActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Actions"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/cardActiveOrder"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="24dp"/>

            <LinearLayout
                android:id="@+id/llQuickActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                app:layout_constraintTop_toBottomOf="@+id/tvQuickActions"
                android:layout_marginTop="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:padding="20dp"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/ivMenuIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_button_primary"
                        android:padding="8dp"
                        android:src="@drawable/ic_back"
                        app:tint="#FFFFFF"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/tvBrowseTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Browse Menu"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        app:layout_constraintTop_toBottomOf="@+id/ivMenuIcon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explore boil bags &amp; starters"
                        android:textColor="#8A8F9E"
                        android:textSize="10sp"
                        android:textAlignment="center"
                        app:layout_constraintTop_toBottomOf="@+id/tvBrowseTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="4dp"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:padding="20dp"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/ivHistoryIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_input_field"
                        android:padding="8dp"
                        android:src="@drawable/ic_back"
                        app:tint="#3B5EFE"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/tvHistoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order History"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        app:layout_constraintTop_toBottomOf="@+id/ivHistoryIcon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View past meals"
                        android:textColor="#8A8F9E"
                        android:textSize="10sp"
                        android:textAlignment="center"
                        app:layout_constraintTop_toBottomOf="@+id/tvHistoryTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="4dp"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPopularPick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Popular Pick"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/llQuickActions"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="24dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@+id/tvPopularPick"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/ivShrimp"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="#0A0D14"
                    android:padding="8dp"
                    android:src="@drawable/app_logo"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvShrimpTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="Cajun Shrimp Boil"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@+id/ivShrimp"
                    app:layout_constraintStart_toEndOf="@+id/ivShrimp"
                    app:layout_constraintEnd_toStartOf="@+id/tvShrimpPrice"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="Shrimp, corn, potatoes &amp; Cajun spices."
                    android:textColor="#8A8F9E"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@+id/tvShrimpTitle"
                    app:layout_constraintStart_toStartOf="@+id/tvShrimpTitle"
                    app:layout_constraintEnd_toStartOf="@+id/tvShrimpPrice"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvShrimpPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="R189"
                    android:textColor="#3B5EFE"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavWrapper"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="#0F131D"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Home"
            android:textColor="#3B5EFE"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_home"
            android:drawableTint="#3B5EFE"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Menu"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_menu"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cart"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_cart"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tracker"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_tracker"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Account"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_account"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>