<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavWrapperMenu">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivMenuLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/app_logo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvMenuBrandTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THE CRUSTY CRAB"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@+id/ivMenuLogo"
                app:layout_constraintStart_toEndOf="@+id/ivMenuLogo"
                android:layout_marginStart="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MONTGOMERY PARK • RANDBURG"
                android:textColor="#3B5EFE"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toBottomOf="@+id/tvMenuBrandTitle"
                app:layout_constraintStart_toStartOf="@+id/tvMenuBrandTitle" />

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_primary"
                android:text="Cart (0)"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toTopOf="@+id/ivMenuLogo"
                app:layout_constraintBottom_toBottomOf="@+id/ivMenuLogo"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvCategoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="US-01 CATEGORY FILTERING"
                android:textColor="#3BA4FE"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/ivMenuLogo"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="32dp"/>

            <TextView
                android:id="@+id/tvMenuHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our Signature\nMenu"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/tvCategoryLabel"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvMenuSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fresh seafood. Cajun flavour. Made your way."
                android:textColor="#8A8F9E"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/tvMenuHeader"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/llFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tvMenuSub"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:text="All Items"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="Boil Bags"
                    android:textColor="#8A8F9E"
                    android:textSize="12sp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_unselected"
                    android:text="Starters"
                    android:textColor="#8A8F9E"
                    android:textSize="12sp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"/>
            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                app:layout_constraintTop_toBottomOf="@+id/llFilters"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Shrimp Boil Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_card_dark"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/ivItem1"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/app_logo"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="16dp"/>

                    <TextView
                        android:id="@+id/tvTag1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BOIL BAG"
                        android:textColor="#3BA4FE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@+id/ivItem1"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="24dp"/>

                    <TextView
                        android:id="@+id/tvTitle1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cajun Shrimp Boil"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@+id/tvTag1"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvDesc1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Shrimp, corn, potatoes and Cajun spices."
                        android:textColor="#8A8F9E"
                        android:textSize="10sp"
                        app:layout_constraintTop_toBottomOf="@+id/tvTitle1"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R189"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="@+id/btnAdd1"
                        app:layout_constraintBottom_toBottomOf="@+id/btnAdd1"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ImageView
                        android:id="@+id/btnAdd1"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_button_primary"
                        android:src="@drawable/ic_back"
                        app:tint="#FFFFFF"
                        android:padding="8dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvDesc1"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="16dp"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Crab Feast Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_card_dark"
                    android:padding="16dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/ivItem2"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/app_logo"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="16dp"/>

                    <TextView
                        android:id="@+id/tvTag2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BOIL BAG"
                        android:textColor="#3BA4FE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@+id/ivItem2"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="24dp"/>

                    <TextView
                        android:id="@+id/tvTitle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crab Feast"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@+id/tvTag2"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvDesc2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Crab, shrimp, corn and signature Cajun sauce."
                        android:textColor="#8A8F9E"
                        android:textSize="10sp"
                        app:layout_constraintTop_toBottomOf="@+id/tvTitle2"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R249"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="@+id/btnAdd2"
                        app:layout_constraintBottom_toBottomOf="@+id/btnAdd2"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <ImageView
                        android:id="@+id/btnAdd2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_button_primary"
                        android:src="@drawable/ic_back"
                        app:tint="#FFFFFF"
                        android:padding="8dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvDesc2"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="16dp"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </GridLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavWrapper"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="#0F131D"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Home"
            android:textColor="#3B5EFE"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_home"
            android:drawableTint="#3B5EFE"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Menu"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_menu"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cart"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_cart"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tracker"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_tracker"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Account"
            android:textColor="#8A8F9E"
            android:textSize="10sp"
            android:textAlignment="center"
            android:drawableTop="@drawable/ic_account"
            android:drawableTint="#8A8F9E"
            android:drawablePadding="4dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>